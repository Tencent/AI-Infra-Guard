# Environment variables — copy to .env and fill in your values
SKILLJACK_API_KEY=your-api-key-here
SKILLJACK_BASE_URL=https://api.openai.com/v1/chat/completions
SKILLJACK_MODEL=deepseek-chat

# Optional: paths to external systems (for cross-system experiments)
SKILLX_PATH=../SkillX
AUTOSKILL_PATH=../anything2skill
