# Path to a local DeepSeek Harness checkout.
DSH_ROOT=/path/to/deepseek-harness

# Use a provider configured in your own DSH environment. No credentials or
# proxy implementation are included in this release.
DSH_MODEL_ID=deepseek-v4-flash
DSH_BASE_URL=https://your-compatible-endpoint.example.invalid/v1

# Optional: point to an externally installed A.I.G/pikit package checkout.
AIG_EVAL_HOME=/path/to/aig-prompt-injection-evaluator
